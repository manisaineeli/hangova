# Copy to .env and fill in what you have. Every value here is optional:
# with none of them set the app still runs, using a development JWT secret and
# the built-in planner instead of Gemini.

# --- required in production -------------------------------------------------
# Shared signing key for the JWT. MUST be the same for the gateway and
# user-service, and MUST be replaced before exposing the app publicly.
# Generate one with:  openssl rand -base64 48
HANGOVA_JWT_SECRET=

# Token lifetime in hours.
HANGOVA_JWT_TTL_HOURS=12

# --- database ---------------------------------------------------------------
# MongoDB connection strings. MongoDB Atlas free tier works for this.
HANGOVA_MONGO_URI=mongodb://localhost:27017/hangova_users
HANGOVA_BOOKING_MONGO_URI=mongodb://localhost:27017/hangova_bookings
HANGOVA_INFO_MONGO_URI=mongodb://localhost:27017/hangova_info

# --- AI (optional) ----------------------------------------------------------
# Without a key the planner uses the built-in curated engine, which works fully.
HANGOVA_GEMINI_API_KEY=
HANGOVA_GEMINI_MODEL=gemini-2.0-flash

# --- live travel data (optional, no key needed) ----------------------------
HANGOVA_WEATHER_ENABLED=true
HANGOVA_GEOCODING_ENABLED=true

# --- service addresses (only change if running off one machine) -------------
HANGOVA_USER_URL=http://localhost:8081
HANGOVA_TRIP_URL=http://localhost:8082
HANGOVA_BOOKING_URL=http://localhost:8083
HANGOVA_INFO_URL=http://localhost:8084
