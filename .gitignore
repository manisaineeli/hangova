# dependencies
node_modules/

# build output
dist/
product/frontend/dist/
product/backend/*/target/

# The front end compiles into the gateway's static resources, so that folder is
# generated output. The Dockerfile rebuilds it from source, and committing it
# would dirty the repository on every local build.
product/backend/api-gateway/src/main/resources/static/

# logs and temp files
*.log
logs/
*.tmp

# local configuration and secrets (never commit these)
.env
.env.*
!.env.example

# tooling binaries downloaded locally
product/cloudflared.exe
product/cloudflared

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
